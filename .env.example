# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o GitHub.
# Supabase -> Connect -> Direct -> Session pooler (URI)
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# Redis local (Docker) ou Upstash (rediss://default:SENHA@host:6379)
REDIS_URL=redis://localhost:6379/0
# Tempo de vida do cache em segundos
CACHE_TTL=60
